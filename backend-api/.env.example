# ==========================================
# FinancieraBan Backend API — Entorno
# ==========================================

# Entorno: 'local' o 'production'
ENV=production
DEBUG=False
APP_NAME=FinancieraBan API

# Seguridad JWT (Generar clave segura con: openssl rand -hex 32)
JWT_SECRET=tu_clave_secreta_super_segura_de_minimo_32_caracteres
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

# Base de Datos MySQL
# Formato: mysql+pymysql://<usuario>:<password>@<host>:<puerto>/<nombre_bd>
DB_URL=mysql+pymysql://financieraban_user:tu_password_seguro@127.0.0.1:3306/financieraban_api

# CORS (Orígenes permitidos separados por coma)
CORS_ORIGINS=https://admin.tudominio.com,https://api.tudominio.com

# SMTP para códigos OTP por correo (Gmail u otro)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_TLS=True
SMTP_USER=tu_correo@gmail.com
SMTP_PASSWORD=tu_contraseña_de_aplicacion
SMTP_FROM=FinancieraBan <tu_correo@gmail.com>

# Configuración OTP
OTP_EXPIRE_MINUTES=5
OTP_MAX_ATTEMPTS=5
