# Laravel
**/web-admin/storage/*.key
**/web-admin/storage/framework/cache/*
**/web-admin/storage/framework/sessions/*
**/web-admin/storage/framework/views/*
**/web-admin/bootstrap/cache/*
!**/web-admin/storage/framework/cache/.gitignore
!**/web-admin/storage/framework/sessions/.gitignore
!**/web-admin/storage/framework/views/.gitignore
!**/web-admin/bootstrap/cache/.gitignore

# Generated Files / Storage
**/backend-api/storage/tickets/*.pdf
!**/backend-api/storage/tickets/.gitkeep

