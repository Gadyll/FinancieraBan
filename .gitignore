# Environments & Credentials
.env
.env.backup
.env.production
.env.local

# Python / Virtual Environment
**/venv/
**/__pycache__/
*.py[cod]
*$py.class
*.sqlite
*.db

# Node / Frontend
**/node_modules/
**/dist/
**/.expo/
npm-debug.log*
yarn-debug.log*
